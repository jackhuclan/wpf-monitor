<UserControl x:Class="IndustrialMonitor.Views.DeviceManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具条 -->
        <Border Style="{StaticResource CardBorder}" Padding="20,14" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="+ 新增设备"
                        Command="{Binding ShowAddCommand}"
                        Visibility="{Binding CanOperate, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock Text="设备状态标识："
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="32,0,0,0"/>
                <Ellipse Width="10" Height="10" Fill="{StaticResource NormalGreenBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="正常" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="6,0,20,0" VerticalAlignment="Center"/>
                <Ellipse Width="10" Height="10" Fill="{StaticResource AlarmRedBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="报警中" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 新增/编辑表单 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="20,14" Margin="0,0,0,16"
                Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="设备编号" Style="{StaticResource FormLabelText}"/>
                        <TextBox Style="{StaticResource FormInput}" Width="180"
                                 Text="{Binding EditId, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="设备名称" Style="{StaticResource FormLabelText}"/>
                        <TextBox Style="{StaticResource FormInput}" Width="220"
                                 Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="确认" Margin="0,0,8,0"
                                Command="{Binding ConfirmFormCommand}"/>
                        <Button Style="{StaticResource GhostButtonStyle}" Content="取消"
                                Command="{Binding CancelFormCommand}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 设备列表 -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid Style="{StaticResource DataGridCardStyle}"
                      ItemsSource="{Binding Devices}"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="状态" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="10" Height="10" HorizontalAlignment="Left"
                                         Margin="12,0,0,0"
                                         Fill="{Binding IsOnline, Converter={StaticResource OnlineDotConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="设备编号" Binding="{Binding Id}" Width="130"/>
                    <DataGridTextColumn Header="设备名称" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="在线状态" Binding="{Binding IsOnline, Converter={StaticResource OnlineTextConverter}}" Width="110"/>
                    <DataGridTemplateColumn Header="操作" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button Style="{StaticResource GhostButtonStyle}" Content="编辑" FontSize="12"
                                            Padding="10,4" Margin="0,0,8,0"
                                            Command="{Binding DataContext.StartEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding DataContext.CanOperate, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button Style="{StaticResource GhostButtonStyle}" Content="启停" FontSize="12"
                                            Padding="10,4" Margin="0,0,8,0"
                                            Command="{Binding DataContext.ToggleOnlineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding DataContext.CanOperate, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button Style="{StaticResource DangerButtonStyle}" Content="删除" FontSize="12"
                                            Padding="10,4"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding DataContext.CanOperate, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
