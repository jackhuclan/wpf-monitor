<UserControl x:Class="IndustrialMonitor.Views.HeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource HeaderBgBrush}" BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid Margin="20,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="首页 /" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="8,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CurrentTitle}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TitleBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- 实时时钟 -->
                <Border Background="{StaticResource BrandLightBrush}" CornerRadius="4" Padding="10,4"
                        Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ClockText" Text="----" FontSize="13"
                                   Foreground="{StaticResource BrandBrush}" Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- 当前用户 -->
                <Border Background="{StaticResource BrandLightBrush}" CornerRadius="4" Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentUser.Username}" FontSize="13"
                                   Foreground="{StaticResource BrandBrush}" Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentUser.Role}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
