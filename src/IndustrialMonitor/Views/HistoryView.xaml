<UserControl x:Class="IndustrialMonitor.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 查询条件 -->
        <Border Style="{StaticResource CardBorder}" Padding="20,14" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="开始日期" FontSize="13" Foreground="{StaticResource TitleBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <DatePicker SelectedDate="{Binding StartDate}" Width="150"/>
                <TextBlock Text="结束日期" FontSize="13" Foreground="{StaticResource TitleBrush}"
                           VerticalAlignment="Center" Margin="24,0,12,0"/>
                <DatePicker SelectedDate="{Binding EndDate}" Width="150"/>
                <TextBlock Text="设备" FontSize="13" Foreground="{StaticResource TitleBrush}"
                           VerticalAlignment="Center" Margin="24,0,12,0"/>
                <ComboBox Style="{StaticResource FormCombo}" Width="200"
                          ItemsSource="{Binding DeviceOptions}"
                          SelectedItem="{Binding SelectedDevice}"/>
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="查询" Margin="20,0,0,0"
                        Command="{Binding SearchCommand}"/>
            </StackPanel>
        </Border>

        <!-- 历史数据列表 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid Style="{StaticResource DataGridCardStyle}"
                      ItemsSource="{Binding Records}"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="类型" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="8,3" HorizontalAlignment="Left"
                                        Background="{Binding Type, Converter={StaticResource AlarmTypeColorConverter}}">
                                    <TextBlock Text="{Binding Type}" Foreground="White" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="设备" Binding="{Binding DeviceId}" Width="110"/>
                    <DataGridTextColumn Header="内容" Binding="{Binding Message}" Width="*"/>
                    <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 分页 -->
        <Border Grid.Row="2" Background="Transparent" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding PageText}" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                           Margin="0,0,16,0"/>
                <Button Style="{StaticResource GhostButtonStyle}" Content="上一页"
                        Command="{Binding PrevPageCommand}"/>
                <Button Style="{StaticResource GhostButtonStyle}" Content="下一页" Margin="8,0,0,0"
                        Command="{Binding NextPageCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
