<Window x:Class="IndustrialMonitor.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录 - 工业设备实时监控平台"
        Width="900" Height="560" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="10" Background="Transparent" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧品牌区：深色背景 + 品牌色 -->
            <Border Grid.Column="0" Background="{StaticResource LoginBgBrush1}">
                <StackPanel VerticalAlignment="Center" Margin="70,0">
                    <Border Width="64" Height="64" CornerRadius="14" Background="{StaticResource BrandBrush}"
                            HorizontalAlignment="Left" Margin="0,0,0,24">
                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="工业设备实时监控平台" FontSize="26" FontWeight="Bold" Foreground="White"
                               FontFamily="Microsoft YaHei UI"/>
                    <TextBlock Text="Industrial Real-Time Monitoring Console" FontSize="13" Foreground="#6B7280"
                               Margin="0,8,0,24"/>
                    <TextBlock Text="·  实时曲线  ·  阈值报警  ·  权限分级  ·  配置热重载"
                               FontSize="14" Foreground="#A9B1C2" LineHeight="28"/>
                    <TextBlock Text="轻量 · 可靠 · 为中小型工业现场而生"
                               FontSize="14" Foreground="#A9B1C2"/>
                </StackPanel>
            </Border>

            <!-- 右侧登录卡片 -->
            <Border Grid.Column="1" Background="{StaticResource LoginCardBrush}">
                <StackPanel VerticalAlignment="Center" Margin="46,0">
                    <TextBlock Text="欢迎登录" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="请使用系统账号进入监控控制台" FontSize="13" Foreground="#8A93A6" Margin="0,8,0,32"/>

                    <TextBlock Text="用户名" Foreground="#A9B1C2" FontSize="13" Margin="0,0,0,8"/>
                    <TextBox x:Name="UsernameBox" Height="42" FontSize="14" Padding="10,0"
                             VerticalContentAlignment="Center" Background="#1B1E30" Foreground="White"
                             BorderBrush="#3A4059" CaretBrush="White"/>
                    <TextBlock x:Name="UsernamePlaceholder" Text="请输入用户名" Foreground="#555C73" FontSize="14"
                               Margin="12,-33,0,0" IsHitTestVisible="False"/>

                    <TextBlock Text="密码" Foreground="#A9B1C2" FontSize="13" Margin="0,20,0,8"/>
                    <TextBox x:Name="PasswordMaskBox" Height="42" FontSize="14" Padding="10,0"
                             VerticalContentAlignment="Center" Background="#1B1E30" Foreground="White"
                             BorderBrush="#3A4059" CaretBrush="White" Visibility="Collapsed"/>
                    <Grid>
                        <PasswordBox x:Name="PasswordBox" Height="42" FontSize="14" Padding="10,0"
                                     VerticalContentAlignment="Center" Background="#1B1E30" Foreground="White"
                                     BorderBrush="#3A4059" CaretBrush="White"/>
                        <TextBlock x:Name="PasswordPlaceholder" Text="请输入密码" Foreground="#555C73" FontSize="14"
                                   Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>

                    <TextBlock x:Name="ErrorText" Foreground="#F0473C" FontSize="13" Margin="0,12,0,0"
                               TextWrapping="Wrap"/>

                    <Button x:Name="LoginButton" Content="登 录" Height="44" Width="268" HorizontalAlignment="Left" FontSize="16" FontWeight="SemiBold"
                            Background="{StaticResource BrandBrush}" Foreground="White" BorderThickness="0"
                            Cursor="Hand" Margin="0,28,0,0" Click="OnLoginClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource BrandHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="默认账号：admin / admin123（管理员）· operator / 123456（操作员）· observer / 123456（观察者）"
                               FontSize="11" Foreground="#555C73" TextWrapping="Wrap" Margin="0,28,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
