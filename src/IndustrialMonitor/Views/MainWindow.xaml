<Window x:Class="IndustrialMonitor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:IndustrialMonitor.Views"
        xmlns:vms="clr-namespace:IndustrialMonitor.ViewModels"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="工业设备实时监控平台" Height="720" Width="1280"
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Background="{StaticResource ContentBgBrush}">
    <Window.Resources>
        <!-- ViewModel → View 映射 -->
        <DataTemplate DataType="{x:Type vms:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:MonitoringViewModel}">
            <views:MonitoringView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:AlarmCenterViewModel}">
            <views:AlarmCenterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:DeviceManagementViewModel}">
            <views:DeviceManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:HistoryViewModel}">
            <views:HistoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:UserManagementViewModel}">
            <views:UserManagementView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 深色侧边栏 220px -->
        <views:SidebarView Grid.Column="0" DataContext="{Binding}"/>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部状态栏：面包屑 + 用户 + 实时时钟 -->
            <views:HeaderView Grid.Row="0" DataContext="{Binding}"/>

            <!-- 内容区 -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="0"/>
        </Grid>
    </Grid>
</Window>
