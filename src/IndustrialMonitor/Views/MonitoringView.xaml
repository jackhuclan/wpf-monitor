<UserControl x:Class="IndustrialMonitor.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl Background="Transparent" BorderThickness="0"
                    ItemsSource="{Binding Devices}"
                    SelectedItem="{Binding SelectedDevice}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Margin="0,0,7,0"
                                 Fill="{Binding IsAlarm, Converter={StaticResource AlarmDotConverter}}"/>
                        <TextBlock Text="{Binding Device.Id}" FontSize="13"/>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="220"/>
                        </Grid.RowDefinitions>

                        <!-- 当前值 + 报警灯 -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="20,14">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,40,0">
                                        <Ellipse x:Name="AlarmLamp" Width="18" Height="18" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource NormalGreenBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource AlarmRedBrush}"/>
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         From="1" To="0.25" Duration="0:0:0.6"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         To="1" Duration="0:0:0.1"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="设备运行正常" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding IsAlarm, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                        <TextBlock Text="报警中" FontSize="13" Foreground="{StaticResource AlarmRedBrush}"
                                                   FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding IsAlarm, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel Margin="0,0,40,0">
                                            <TextBlock Text="温度（℃）" Style="{StaticResource CardTitleText}"/>
                                            <TextBlock Text="{Binding LastTemperature, StringFormat={}{0:F1}}"
                                                       FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrandBrush}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,40,0">
                                            <TextBlock Text="压力（MPa）" Style="{StaticResource CardTitleText}"/>
                                            <TextBlock Text="{Binding LastPressure, StringFormat={}{0:F2}}"
                                                       FontSize="24" FontWeight="Bold" Foreground="#22B08C"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="设备名称" Style="{StaticResource CardTitleText}"/>
                                            <TextBlock Text="{Binding Device.Name}" FontSize="13"
                                                       Foreground="{StaticResource TitleBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="{Binding WindowInfoText}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 双通道折线图 -->
                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="10,8">
                            <Grid>
                                <lvc:CartesianChart Series="{Binding Series}"
                                                    XAxes="{Binding XAxes}"
                                                    YAxes="{Binding YAxes}"
                                                    Sections="{Binding Sections}"
                                                    ZoomMode="X"
                                                    TooltipPosition="Center"/>
                                <!-- 图例 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,6,16,0">
                                    <Ellipse Width="10" Height="10" Fill="{StaticResource BrandBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="温度" FontSize="12" Margin="5,0,16,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Ellipse Width="10" Height="10" Fill="#22B08C" VerticalAlignment="Center"/>
                                    <TextBlock Text="压力" FontSize="12" Margin="5,0,16,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Rectangle Width="14" Height="2" Fill="{StaticResource TempAlarmBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="温度阈值" FontSize="12" Margin="5,0,16,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Rectangle Width="14" Height="2" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="压力阈值" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 最近报警 -->
                        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="最近报警" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TitleBrush}" Margin="20,12,0,8"/>
                                <DataGrid Grid.Row="1" Style="{StaticResource DataGridCardStyle}"
                                          ItemsSource="{Binding RecentAlarms}"
                                          BorderThickness="0,1,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="类型" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="3" Padding="8,3" HorizontalAlignment="Left"
                                                            Background="{Binding Type, Converter={StaticResource AlarmTypeColorConverter}}">
                                                        <TextBlock Text="{Binding Type}" Foreground="White" FontSize="12"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="设备" Binding="{Binding DeviceId}" Width="110"/>
                                        <DataGridTextColumn Header="报警内容" Binding="{Binding Message}" Width="*"/>
                                        <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="180"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</UserControl>
