<UserControl x:Class="IndustrialMonitor.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource SidebarBgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 品牌区 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource BrandBrush}">
                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="设备监控平台" FontSize="15" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Industrial Monitor" FontSize="10" Foreground="#6B7280"/>
                </StackPanel>
            </StackPanel>

            <!-- 菜单（按角色过滤） -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8">
                <ItemsControl ItemsSource="{Binding MenuItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SideMenuItemButton}"
                                    Tag="{Binding IsActive}"
                                    Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource SideMenuGlyph}"
                                               Text="{Binding Glyph}"/>
                                    <TextBlock Style="{StaticResource SideMenuText}"
                                               Text="{Binding Title}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 底部：用户信息 + 退出登录 -->
            <StackPanel Grid.Row="2" Margin="16,4,16,16">
                <Border Height="1" Background="#3A4059" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" Margin="4,0,0,10">
                    <Border Width="30" Height="30" CornerRadius="15" Background="#3A4059">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="#A9B1C2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentUser.Username}" FontSize="13" Foreground="White"/>
                        <TextBlock Text="{Binding CurrentUser.Role}" FontSize="11" Foreground="#6B7280"/>
                    </StackPanel>
                </StackPanel>
                <Button Height="36" Cursor="Hand" Click="OnLogoutClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Foreground="#E5484D"/>
                                    <TextBlock Text="退出登录" FontSize="13" Foreground="#E5484D" Margin="10,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#343A4E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
