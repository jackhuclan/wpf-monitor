<UserControl x:Class="IndustrialMonitor.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 新增用户 -->
        <Border Style="{StaticResource CardBorder}" Padding="20,14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="新增用户" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="用户名" Style="{StaticResource FormLabelText}"/>
                        <TextBox Style="{StaticResource FormInput}" Width="180"
                                 Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="密码（≥6位）" Style="{StaticResource FormLabelText}"/>
                        <TextBox Style="{StaticResource FormInput}" Width="180"
                                 Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="角色" Style="{StaticResource FormLabelText}"/>
                        <ComboBox Style="{StaticResource FormCombo}" Width="140"
                                  ItemsSource="{Binding RoleOptions}"
                                  SelectedItem="{Binding NewRole}"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="新增用户"
                                Command="{Binding AddUserCommand}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 用户列表 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid Style="{StaticResource DataGridCardStyle}"
                      ItemsSource="{Binding Users}"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="用户名" Binding="{Binding Username}" Width="160"/>
                    <DataGridTemplateColumn Header="角色" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="8,3" HorizontalAlignment="Left"
                                        Background="{StaticResource BrandLightBrush}">
                                    <TextBlock Text="{Binding Role}" FontSize="12"
                                               Foreground="{StaticResource BrandBrush}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="状态" Width="100">
                        <DataGridTextColumn.Binding>
                            <Binding Path="IsActive" Converter="{StaticResource AccountStatusTextConverter}"/>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="操作" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButtonStyle}" FontSize="12" Padding="10,4"
                                        Margin="8,0,0,0" HorizontalAlignment="Left"
                                        Content="{Binding IsActive, Converter={StaticResource ActiveButtonTextConverter}}"
                                        Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
